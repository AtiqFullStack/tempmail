MONGODB_URI=mongodb://127.0.0.1:27017/tempmail
MAIL_DOMAIN=mailizator.com
NEXT_PUBLIC_MAIL_DOMAIN=mailizator.com
MAIL_RETENTION_HOURS=1
MAX_EMAIL_SIZE_MB=2
MAX_STORED_BYTES=268435456
# true only behind the loopback-bound Next server and trusted Nginx proxy
TRUST_PROXY=false
# Production worker (set externally in the Postfix transport):
# MAIL_ENV_FILE=/etc/tempmail/worker.env
